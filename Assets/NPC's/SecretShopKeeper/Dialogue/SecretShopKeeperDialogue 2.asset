  m_Script: {fileID: 11500000, guid: 36c3b15dae223394db48d9e2a233053a, type: 3}
  m_Name: SecretShopKeeperDialogue 2
  m_EditorClassIdentifier: Assembly-CSharp::NPC_Dialogue
  npcName: Odd Ant
  lines:
  - text: Say, if you got the time to be climbing around here...
    portrait: {fileID: 7057801135558962131, guid: 278bcb241cd705b41bd7cdd5a2615b66, type: 3}
  - text: Can ya make the time to find my key? I may or may-NOT be willing to share
      some goodies in my abode, if you depart with some honey.
    portrait: {fileID: -8777675115329645790, guid: 278bcb241cd705b41bd7cdd5a2615b66, type: 3}
  - text: See, I sorta lost it at The Bay and ain't had the chance to get back there.
      Whole' "Strength In Numbers" thing, y'know?
    portrait: {fileID: 4595640348019049623, guid: 278bcb241cd705b41bd7cdd5a2615b66, type: 3}
  - text: Its- It's wooden, I carved it myself!
    portrait: {fileID: 4178722539803452060, guid: 278bcb241cd705b41bd7cdd5a2615b66, type: 3}
  - text: Thanks, kid..
    portrait: {fileID: 255001972926481289, guid: 278bcb241cd705b41bd7cdd5a2615b66, type: 3}
  typingSpeed: 0.05
  talkSound: {fileID: 8300000, guid: 8cec6fb381634fb47ad0f4a9c5b9a9e6, type: 3}
  choices: []
